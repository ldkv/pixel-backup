# Copy to .env and customize. All values are optional; defaults shown below.

# Host directory bind-mounted into the container at the same path.
# MUST be a common parent of every user's source_dir AND of SYNCTHING_DIR,
# so that hard links between them stay on the same filesystem.
# Example layout:
#   /mnt/media/library/alice/   <- user alice source_dir
#   /mnt/media/library/bob/     <- user bob source_dir
#   /mnt/media/syncthing/       <- SYNCTHING_DIR (hard-link staging)
DATA_ROOT=/mnt/media
SYNCTHING_DIR=/mnt/media/syncthing # Directory where hard links are created. Must live under DATA_ROOT.


# Service configurations
LOCAL_DATA_DIR=/path/to/persists/the/docker/db/volume
ADMIN_PASSWORD=admin
API_PORT=8000
PHONE_LIMIT_GB=19.0
CRON_SCHEDULE=0 0 * * *
TIMEZONE=UTC
MIN_SLEEP_SECONDS=60

# Optional Discord webhook for sync notifications. Leave unset to disable.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
